  "services": {
    "set_schedule": {
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "HA device id of the thermostat (or its raw Tuya device_id). Ignored when \"all\" is set.",
          "required": false,
          "selector": {
            "device": {
              "integration": "danfoss_local",
              "multiple": false
            }
          }
        },
        "all": {
          "name": "All thermostats",
          "description": "Apply to every thermostat instead of one device.",
          "required": false,
          "selector": {
            "boolean": {}
          }
        },
        "program": {
          "name": "Program",
          "description": "{\"days\": [[{\"start\": \"06:00\", \"end\": \"08:00\"}, {\"start\": \"16:00\", \"end\": \"22:30\"}], [], [], [], [], [], []]}",
          "required": true,
          "selector": {
            "object": {
              "multiple": false
            }
          }
        },
        "enabled": {
          "name": "Enabled",
          "description": "Leave the schedule enabled/disabled after saving (unchanged if omitted).",
          "required": false,
          "selector": {
            "boolean": {}
          }
        }
      },
      "description": "Replace a thermostat's weekly program in the Danfoss Ally shape - 7 days (Mon..Sun) of \"at home\" windows on a 30-minute grid; everything outside a window is \"away\".",
      "name": "Set weekly schedule"
    },
    "clear_schedule": {
      "fields": {
        "device_id": {
          "name": "Device",
          "required": false,
          "selector": {
            "device": {
              "integration": "danfoss_local",
              "multiple": false
            }
          }
        },
        "all": {
          "name": "All thermostats",
          "required": false,
          "selector": {
            "boolean": {}
          }
        }
      },
      "description": "Remove the thermostat's program entirely (HA stops driving it).",
      "name": "Clear weekly schedule"
    },
    "copy_schedule": {
      "fields": {
        "device_id": {
          "name": "Source device",
          "required": true,
          "selector": {
            "device": {
              "integration": "danfoss_local",
              "multiple": false
            }
          }
        },
        "targets": {
          "name": "Target devices",
          "required": false,
          "selector": {
            "device": {
              "multiple": true,
              "integration": "danfoss_local"
            }
          }
        }
      },
      "description": "Copy one thermostat's weekly program to the given targets (all thermostats if targets is omitted). Holidays and enabled flags of the targets are kept.",
      "name": "Copy schedule to other thermostats"
    },
    "set_holiday": {
      "fields": {
        "device_id": {
          "name": "Device",
          "required": false,
          "selector": {
            "device": {
              "integration": "danfoss_local",
              "multiple": false
            }
          }
        },
        "all": {
          "name": "All thermostats",
          "required": false,
          "selector": {
            "boolean": {}
          }
        },
        "kind": {
          "name": "Kind",
          "required": true,
          "selector": {
            "select": {
              "options": [
                "away",
                "at_home"
              ],
              "multiple": false,
              "custom_value": false,
              "sort": false
            }
          }
        },
        "start": {
          "name": "Start",
          "description": "Datetime for \"away\" (e.g. 2026-12-24 18:00), date for \"at_home\" (2026-12-24).",
          "required": true,
          "selector": {
            "text": {
              "multiline": false,
              "multiple": false
            }
          }
        },
        "end": {
          "name": "End",
          "description": "Datetime for \"away\", inclusive date for \"at_home\".",
          "required": true,
          "selector": {
            "text": {
              "multiline": false,
              "multiple": false
            }
          }
        }
      },
      "description": "Danfoss-style holiday. \"away\" holds the thermostat in holiday mode between two datetimes; \"at_home\" replays Saturday's windows on every day of a date range (Saturday must be set).",
      "name": "Set holiday"
    },
    "clear_holiday": {
      "fields": {
        "device_id": {
          "name": "Device",
          "required": false,
          "selector": {
            "device": {
              "integration": "danfoss_local",
              "multiple": false
            }
          }
        },
        "all": {
          "name": "All thermostats",
          "required": false,
          "selector": {
            "boolean": {}
          }
        }
      },
      "name": "Clear holiday"
    },
    "enable_schedule": {
      "fields": {
        "device_id": {
          "name": "Device",
          "required": false,
          "selector": {
            "device": {
              "integration": "danfoss_local",
              "multiple": false
            }
          }
        },
        "all": {
          "name": "All thermostats",
          "required": false,
          "selector": {
            "boolean": {}
          }
        },
        "enabled": {
          "name": "Enabled",
          "required": true,
          "selector": {
            "boolean": {}
          }
        }
      },
      "description": "Pause the weekly program without deleting it.",
      "name": "Enable or disable schedule"
    }
  }
}
